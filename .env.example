# PostgreSQL connection string (e.g. Supabase Postgres)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Long random secret used to sign JWT auth tokens
JWT_SECRET="replace-with-a-long-random-secret"

# Where post images are written on disk, served at /uploads/<file>.
# Relative paths resolve from the app directory; containers use /app/uploads.
UPLOAD_DIR="uploads"

# --- Docker Compose only (ignored by `npm run dev`) ---
# Credentials for the local Postgres container; used to build the container's
# DATABASE_URL. The container never reads DATABASE_URL from this file.
POSTGRES_USER="offscript"
POSTGRES_PASSWORD="offscript"
POSTGRES_DB="offscript"
# Host port mappings, change if 5432/3000/3001 are taken.
POSTGRES_PORT="5432"
APP_PORT="3000"
DEV_APP_PORT="3001"
