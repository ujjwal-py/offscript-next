# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which a fresh clone needs (README says `cp .env.example .env`)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (like the original server's src/generated)
/src/generated/

# uploaded images (post images now live on local disk; see UPLOAD_DIR)
/uploads/
# pre-migration images still served from here as a fallback
/public/uploads/

# backups written by scripts/backup.sh
/backups/

# editor / OS
.idea/
.vscode/
Thumbs.db
